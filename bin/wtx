#!/usr/bin/env bash
# wtx - git worktrees as repo siblings. See README.md.
set -euo pipefail

WTX_VERSION="0.0.0-alpha"

# --- output ----------------------------------------------------------------
# All messages go to stderr; stdout is reserved for paths and tables.

if [[ -t 2 && -z ${NO_COLOR-} ]]; then
  C_RED=$'\033[31m'
  C_YEL=$'\033[33m'
  C_OFF=$'\033[0m'
else
  C_RED='' C_YEL='' C_OFF=''
fi

info() { printf '%s\n' "$*" >&2; }
warn() { printf '%swtx: %s%s\n' "$C_YEL" "$*" "$C_OFF" >&2; }

die() {
  printf '%swtx: %s%s\n' "$C_RED" "$*" "$C_OFF" >&2
  exit 1
}

usage_err() {
  printf '%swtx: %s%s\n' "$C_RED" "$*" "$C_OFF" >&2
  printf "run 'wtx help' for usage\n" >&2
  exit 2
}

usage() {
  cat <<'EOF'
wtx - git worktrees as repo siblings

usage:
  wtx new <name> [--branch <branch>] [--from <ref>] [--parent <dir>] [--resume]
  wtx rm  [<name|branch>] [--force]
  wtx ls  [--all]
  wtx help
  wtx --version

new   create <parent>/<name> with a new branch off the default branch, copy the
      files listed in .worktreeinclude, install dependencies, open VSCode.
      if the branch already exists, offer to resume from it.
rm    remove a worktree and its directory. never deletes the branch.
      without a name, pick from a list (fzf if installed, else a menu).
ls    list worktrees grouped by repo. --all covers every repo wtx has seen.

  --branch <branch>  branch name, if it should differ from the directory name
  --from <ref>       what to branch off, instead of the default branch
  --parent <dir>     where to put the worktree
  --resume           check out an existing branch without asking
  --force            remove even with uncommitted or unpushed work
  --all              every repo, not just this one

parent directory defaults to ../<repo>-worktrees; set WTX_PARENT to change it.
stdout is data, stderr is messages. exit 0 ok, 1 failed, 2 bad usage.
EOF
}

# --- git -------------------------------------------------------------------

require_repo() {
  git rev-parse --git-common-dir >/dev/null 2>&1 ||
    die "not a git repository: $PWD"
  if [[ $(git rev-parse --is-bare-repository) == true ]]; then
    die "bare repositories are not supported"
  fi
}

# The main checkout, even when called from inside another worktree: .git is
# shared, so --git-common-dir always points at the main one.
main_checkout() {
  dirname "$(git rev-parse --path-format=absolute --git-common-dir)"
}

# The name becomes a directory, so kebab-case it.
sanitize_name() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

worktree_parent() {
  if [[ -n ${WTX_PARENT-} ]]; then
    printf '%s\n' "$WTX_PARENT"
    return 0
  fi
  printf '%s/%s-worktrees\n' "$(dirname "$1")" "$(basename "$1")"
}

# The branch to start new work from, as a ref.
#   origin/HEAD  - set at clone time, records what the remote calls its default
#                  branch, so this is right in a master or develop repo
#   origin/main  - for clones old enough to be missing origin/HEAD
#   main / HEAD  - no remote at all, so there is no remote default to read
# Empty only in a repo with no commits; callers decide whether that is fatal.
default_base() {
  local head
  head=$(git -C "$1" symbolic-ref --quiet refs/remotes/origin/HEAD) || head=''
  if [[ -n $head ]]; then
    printf '%s\n' "${head#refs/remotes/}"
    return 0
  fi
  local ref
  for ref in origin/main main HEAD; do
    if git -C "$1" rev-parse --verify --quiet "$ref" >/dev/null; then
      printf '%s\n' "$ref"
      return 0
    fi
  done
}

# One TAB-separated line per worktree: path, branch ("-" if detached), state,
# HEAD commit.
list_worktrees() {
  git -C "$1" worktree list --porcelain | awk '
    function flush() {
      if (p != "") print p "\t" (b == "" ? "-" : b) "\t" s "\t" (h == "" ? "-" : h)
    }
    /^worktree /   { flush(); p = substr($0, 10); b = ""; s = "ok"; h = "" }
    /^HEAD /       { h = substr($0, 6) }
    /^branch /     { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
    /^detached$/   { b = "" }
    /^prunable /   { s = "gone" }
    /^locked/      { s = "locked" }
    END            { flush() }
  '
}

# What to call a worktree's branch in messages and tables. A detached HEAD has
# no branch, so name the commit the way `git branch` does.
branch_label() {
  local branch=$1 head=$2
  if [[ $branch != '-' ]]; then
    printf '%s\n' "$branch"
  elif [[ $head != '-' ]]; then
    printf '(detached %s)\n' "${head:0:7}"
  else
    printf '%s\n' -
  fi
}

# --- registry --------------------------------------------------------------
# git has no global list of repos, so `ls --all` needs one. new and ls append
# to it, so a repo registers itself the first time you use wtx in it.

registry_file() {
  printf '%s/wtx/repos\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

register_repo() {
  local file
  file=$(registry_file)
  mkdir -p "$(dirname "$file")"
  if [[ -f $file ]] && grep -qxF "$1" "$file"; then return 0; fi
  printf '%s\n' "$1" >>"$file"
}

# Registered repos that still exist, most recently registered last.
registered_repos() {
  local file repo
  file=$(registry_file)
  if [[ ! -f $file ]]; then return 0; fi
  while IFS= read -r repo; do
    if [[ -n $repo ]] && [[ -d $repo/.git ]]; then printf '%s\n' "$repo"; fi
  done <"$file"
}

# --- ls --------------------------------------------------------------------

# "+ahead/-behind" against the default branch. Not against the upstream:
# branches made by `wtx new` have none, so those counts would always be empty.
ahead_behind() {
  local repo=$1 branch=$2 base=$3
  if [[ $branch == '-' || -z $base ]]; then
    printf '%s\n' -
    return 0
  fi
  local counts
  counts=$(git -C "$repo" rev-list --left-right --count "$base...$branch" 2>/dev/null) ||
    {
      printf '%s\n' -
      return 0
    }
  printf '+%s/-%s\n' "$(printf '%s' "$counts" | cut -f2)" \
    "$(printf '%s' "$counts" | cut -f1)"
}

# One TAB-separated line per worktree with what ls and the rm picker show:
# path, branch, branch label, status, ±base, commit time (unix), commit time
# (relative). Missing values are "-".
worktree_rows() {
  local repo=$1 base=$2
  local path branch state head dirty when
  while IFS=$'\t' read -r path branch state head; do
    if [[ ! -d $path ]]; then
      dirty=gone
      when=$'-\t-'
    else
      dirty=clean
      if [[ -n $(git -C "$path" status --porcelain) ]]; then dirty=dirty; fi
      when=$(git -C "$path" log -1 --format='%ct%x09%cr' 2>/dev/null) ||
        when=$'-\t-'
    fi
    if [[ $state == locked ]]; then dirty="$dirty,locked"; fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$path" "$branch" "$(branch_label "$branch" "$head")" "$dirty" \
      "$(ahead_behind "$repo" "$branch" "$base")" "$when"
  done < <(list_worktrees "$repo")
}

# "2h ago" as "2h": the long form is most of what makes ls wrap.
short_age() {
  local then=$1 now=$2
  if [[ $then == '-' ]]; then
    printf '%s\n' -
    return 0
  fi
  local s=$((now - then))
  if ((s < 60)); then
    printf '%s\n' now
  elif ((s < 3600)); then
    printf '%sm\n' $((s / 60))
  elif ((s < 86400)); then
    printf '%sh\n' $((s / 3600))
  elif ((s < 604800)); then
    printf '%sd\n' $((s / 86400))
  elif ((s < 2592000)); then
    printf '%sw\n' $((s / 604800))
  elif ((s < 31536000)); then
    printf '%smo\n' $((s / 2592000))
  else
    printf '%sy\n' $((s / 31536000))
  fi
}

# $HOME as ~, for display only.
tilde() {
  case $1 in
    "$HOME") printf '%s\n' '~' ;;
    "$HOME"/*) printf '%s/%s\n' '~' "${1#"$HOME"/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# What to show for a worktree: its folder name when it sits where wtx puts
# worktrees (that is also what `wtx rm` matches), its full path otherwise, so
# one made somewhere else stands out.
worktree_name() {
  local repo=$1 wt_parent=$2 path=$3
  if [[ $path == "$repo" || $(dirname "$path") == "$wt_parent" ]]; then
    basename "$path"
  else
    tilde "$path"
  fi
}

# Asked of the terminal itself: `tput cols` finds it through stderr, so with
# stderr silenced it quietly answers 80.
terminal_width() {
  local cols=${COLUMNS-} size
  if [[ -z $cols ]]; then
    size=$(stty size </dev/tty 2>/dev/null) || size=''
    cols=${size#* }
  fi
  if [[ -z $cols || $cols == 0 ]]; then cols=80; fi
  printf '%s\n' "$cols"
}

# Align a table of TAB-separated rows, indented by 2, trimming the first two
# columns (NAME, BRANCH) with … until it fits in $1 columns. Never below 12
# characters: past that, let the terminal wrap. Aligned here rather than with
# `column -t`, which counts bytes, so … and ± made rows wider than planned.
fit_table() {
  local width=$1 min=12
  local -a lines=() w=() f=()
  local line i n=0
  while IFS= read -r line; do
    lines+=("$line")
    IFS=$'\t' read -r -a f <<<"$line"
    for ((i = 0; i < ${#f[@]}; i++)); do
      if ((${#f[i]} > ${w[i]:-0})); then w[i]=${#f[i]}; fi
    done
    if ((${#f[@]} > n)); then n=${#f[@]}; fi
  done

  # 2 of indent, then each column plus 2 spaces between columns
  local total=2
  for ((i = 0; i < n; i++)); do total=$((total + w[i] + 2)); done
  total=$((total - 2))
  while ((total > width)); do
    if ((w[0] >= w[1] && w[0] > min)); then
      w[0]=$((w[0] - 1))
    elif ((w[1] > min)); then
      w[1]=$((w[1] - 1))
    elif ((w[0] > min)); then
      w[0]=$((w[0] - 1))
    else
      break
    fi
    total=$((total - 1))
  done

  for line in "${lines[@]}"; do
    IFS=$'\t' read -r -a f <<<"$line"
    # A full path keeps its end, where the folder name is: "…/spike".
    case ${f[0]} in
      /* | '~'*)
        if ((${#f[0]} > w[0])); then
          f[0]="…${f[0]:${#f[0]}-w[0]+1}"
        fi
        ;;
    esac
    for i in 0 1; do
      if ((${#f[i]} > w[i])); then f[i]="${f[i]:0:w[i]-1}…"; fi
    done
    line='  '
    for ((i = 0; i < ${#f[@]}; i++)); do
      line+=${f[i]}
      if ((i < ${#f[@]} - 1)); then
        line+=$(printf '%*s' $((w[i] - ${#f[i]} + 2)) '')
      fi
    done
    printf '%s\n' "$line"
  done
}

# One group: a header, then the rows aligned on their own. Piping each group
# separately keeps a wide path in one repo from padding another.
# In a terminal the values are shortened to fit; piped, they stay full.
print_repo_group() {
  local repo=$1
  local parent base base_label wt_parent
  parent=$(dirname "$repo")
  base=$(default_base "$repo")
  base_label=${base##*/} # origin/main -> main
  if [[ -z $base_label ]]; then base_label=base; fi
  wt_parent=$(worktree_parent "$repo")
  wt_parent=${wt_parent%/}

  local path branch label dirty ab ct cr
  if [[ -t 1 ]]; then
    # only name the worktrees folder when it is not the usual sibling one
    printf '\n%s  %s' "$(basename "$repo")" "$(tilde "$repo")"
    if [[ $wt_parent != "$parent/$(basename "$repo")-worktrees" ]]; then
      printf '  →  worktrees in %s/' "$(tilde "$wt_parent")"
    fi
    printf '\n'
    local now
    now=$(date +%s)
    {
      # header names what it compares against: ±main, ±master, ±develop
      printf 'NAME\tBRANCH\tSTATE\t±%s\tAGE\n' "$base_label"
      while IFS=$'\t' read -r path branch label dirty ab ct cr; do
        if [[ $path == "$repo" ]]; then label="$label *"; fi
        printf '%s\t%s\t%s\t%s\t%s\n' \
          "$(worktree_name "$repo" "$wt_parent" "$path")" \
          "$label" "$dirty" "$ab" "$(short_age "$ct" "$now")"
      done < <(worktree_rows "$repo" "$base")
    } | fit_table "$(terminal_width)"
    return 0
  fi

  printf '\n%s (%s)\n' "$(basename "$repo")" "$parent"
  {
    printf 'PATH\tBRANCH\tSTATE\t±%s\tLAST COMMIT\n' "$base_label"
    while IFS=$'\t' read -r path branch label dirty ab ct cr; do
      if [[ $path == "$repo" ]]; then label="$label (main checkout)"; fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$path" "$label" "$dirty" "$ab" "$cr"
    done < <(worktree_rows "$repo" "$base")
  } | column -t -s $'\t' | sed 's/^/  /'
}

cmd_ls() {
  local all=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --all | -a) all=1 ;;
      *) usage_err "unknown argument: $1" ;;
    esac
    shift
  done

  if [[ $all -eq 1 ]]; then
    local found=0 repo
    while IFS= read -r repo; do
      print_repo_group "$repo"
      found=1
    done < <(registered_repos)
    if [[ $found -eq 0 ]]; then
      info "no repos registered yet - run wtx ls or wtx new inside one"
    fi
    return 0
  fi

  require_repo
  local repo
  repo=$(main_checkout)
  register_repo "$repo"
  print_repo_group "$repo"
}

# --- new -------------------------------------------------------------------

open_editor() {
  if ! command -v code >/dev/null; then
    warn "code is not on PATH, no window opened"
    return 0
  fi
  code -n "$1" >&2 || warn "could not open a VSCode window for $1"
}

create_branch_worktree() {
  local repo=$1 branch=$2 dest=$3 from=$4

  if git -C "$repo" remote | grep -qx origin; then
    info "fetching origin..."
    git -C "$repo" fetch --quiet origin ||
      warn "fetch failed, using the origin refs already on disk"
  fi

  # Resolve after the fetch, so origin/HEAD is as fresh as it can be.
  local base=$from
  if [[ -z $base ]]; then base=$(default_base "$repo"); fi
  if [[ -z $base ]]; then
    die "nothing to branch from here; pass --from <ref>"
  fi
  if ! git -C "$repo" rev-parse --verify --quiet "$base" >/dev/null; then
    die "cannot resolve $base"
  fi
  info "branching off $base"

  # --no-track, or git makes the base the new branch's upstream and a later
  # `git push` aims at main. No upstream is deliberate: your first push fails
  # with the `--set-upstream` command to copy, which is how you already work.
  git -C "$repo" worktree add --no-track -b "$branch" "$dest" "$base" >&2 ||
    die "git worktree add failed for $dest"
}

# A worktree is a fresh checkout, so gitignored files like .env are missing and
# most projects do not boot. Plain globs, one per line, not gitignore syntax:
# no negations. A pattern matching a directory copies it whole, so a careless
# glob can make `wtx new` slow - that is on whoever wrote the pattern.
copy_includes() {
  local repo=$1 dest=$2
  local file="$repo/.worktreeinclude"
  if [[ ! -f $file ]]; then return 0; fi

  local files=0 dirs=0 pattern src rel
  while IFS= read -r pattern || [[ -n $pattern ]]; do
    pattern=${pattern%%#*}
    pattern=$(printf '%s' "$pattern" | tr -d '[:space:]')
    pattern=${pattern%/} # "certs/" and "certs" mean the same thing
    if [[ -z $pattern ]]; then continue; fi
    # shellcheck disable=SC2086  # unquoted on purpose: the glob must expand
    for src in "$repo"/$pattern; do
      if [[ ! -e $src ]]; then continue; fi
      rel=${src#"$repo"/}
      mkdir -p "$dest/$(dirname "$rel")"
      # -R so a directory comes whole, -p to keep modes and times - a 600 key
      # must stay 600. cp keeps symlinks as symlinks rather than following them.
      cp -Rp "$src" "$dest/$rel"
      if [[ -d $src ]]; then dirs=$((dirs + 1)); else files=$((files + 1)); fi
    done
  done <"$file"

  if [[ $dirs -gt 0 ]]; then
    info "copied $files file(s) and $dirs directory(ies) from .worktreeinclude"
  elif [[ $files -gt 0 ]]; then
    info "copied $files file(s) from .worktreeinclude"
  fi
}

# Install before the editor opens, so the window is ready when it appears.
# Detected from the lockfile; first match wins. This runs in your shell's
# environment, so nvm's node is already on PATH - no `nvm use` dance needed.
run_setup() {
  local dest=$1
  local -a install_cmd=()

  if [[ -f $dest/pnpm-lock.yaml ]]; then
    install_cmd=(pnpm install)
  elif [[ -f $dest/bun.lock || -f $dest/bun.lockb ]]; then
    install_cmd=(bun install)
  elif [[ -f $dest/yarn.lock ]]; then
    install_cmd=(yarn install)
  elif [[ -f $dest/package-lock.json ]]; then
    install_cmd=(npm install)
  elif [[ -f $dest/uv.lock ]]; then
    install_cmd=(uv sync)
  elif [[ -f $dest/Cargo.lock ]]; then
    install_cmd=(cargo fetch)
  fi

  if [[ ${#install_cmd[@]} -eq 0 ]]; then
    # Say so: an undetected repo should not look like a silent no-op.
    info "no lockfile found, skipping dependency install"
    return 0
  fi
  if ! command -v "${install_cmd[0]}" >/dev/null; then
    warn "${install_cmd[0]} is not on PATH, skipping ${install_cmd[*]}"
    return 0
  fi

  info "running ${install_cmd[*]}"
  # A failed install still leaves a usable worktree, so warn and carry on.
  (cd "$dest" && "${install_cmd[@]}") >&2 ||
    warn "${install_cmd[*]} failed; run it yourself in $dest"
}

resume_branch() {
  local repo=$1 branch=$2 dest=$3 resume=$4

  local existing
  existing=$(list_worktrees "$repo" |
    awk -F'\t' -v b="$branch" '$2 == b { print $1; exit }')

  if [[ -n $existing ]]; then
    info "branch $branch is already checked out at $existing"
    open_editor "$existing"
    printf '%s\n' "$existing"
    exit 0
  fi

  if [[ $resume -eq 0 ]]; then
    if [[ ! -t 0 ]]; then
      die "branch $branch already exists; pass --resume to check it out into $dest"
    fi
    info "branch $branch already exists and is not checked out anywhere"
    local reply
    read -rp "resume from it in $dest? [y/N] " reply
    case $reply in
      [yY] | [yY][eE][sS]) ;;
      *) die "aborted" ;;
    esac
  fi

  git -C "$repo" worktree add "$dest" "$branch" >&2 ||
    die "git worktree add failed for $dest"
}

cmd_new() {
  local name='' branch='' from='' parent='' resume=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --branch)
        branch=${2-}
        if [[ -z $branch ]]; then usage_err "--branch needs a value"; fi
        shift
        ;;
      --from)
        from=${2-}
        if [[ -z $from ]]; then usage_err "--from needs a value"; fi
        shift
        ;;
      --parent)
        parent=${2-}
        if [[ -z $parent ]]; then usage_err "--parent needs a value"; fi
        shift
        ;;
      --resume) resume=1 ;;
      -*) usage_err "unknown flag: $1" ;;
      *)
        if [[ -n $name ]]; then usage_err "new takes one name"; fi
        name=$1
        ;;
    esac
    shift
  done
  if [[ -z $name ]]; then usage_err "new needs a name"; fi

  require_repo
  local repo
  repo=$(main_checkout)
  register_repo "$repo"

  name=$(sanitize_name "$name")
  if [[ -z $name ]]; then die "that name has no usable characters in it"; fi
  if [[ -z $branch ]]; then branch=$name; fi
  git check-ref-format --branch "$branch" >/dev/null 2>&1 ||
    die "not a valid branch name: $branch"

  if [[ -z $parent ]]; then parent=$(worktree_parent "$repo"); fi
  local dest="$parent/$name"
  if [[ -e $dest ]]; then die "already exists: $dest"; fi
  mkdir -p "$parent"

  if git -C "$repo" show-ref --quiet --verify "refs/heads/$branch"; then
    resume_branch "$repo" "$branch" "$dest" "$resume"
  else
    create_branch_worktree "$repo" "$branch" "$dest" "$from"
  fi

  copy_includes "$repo" "$dest"
  run_setup "$dest"
  open_editor "$dest"
  info "worktree ready at $dest on branch $branch"
  printf '%s\n' "$dest"
}

# --- rm --------------------------------------------------------------------

# Match by branch name or by directory basename, raw or kebab-cased. Never
# rebuild the path from the name: a worktree's directory and its branch can
# differ, and --parent means the path is not predictable anyway.
find_worktree() {
  local repo=$1 raw=$2 sane=$3
  list_worktrees "$repo" | awk -F'\t' -v raw="$raw" -v sane="$sane" -v r="$repo" '
    $1 == r { next }
    $2 == raw || $2 == sane { print; next }
    { k = split($1, a, "/"); if (a[k] == raw || a[k] == sane) print }
  '
}

cmd_rm() {
  local force=0 needle=''
  while [[ $# -gt 0 ]]; do
    case $1 in
      --force | -f) force=1 ;;
      -*) usage_err "unknown flag: $1" ;;
      *)
        if [[ -n $needle ]]; then usage_err "rm takes one name"; fi
        needle=$1
        ;;
    esac
    shift
  done
  if [[ -z $needle ]]; then
    if [[ ! -t 0 || ! -t 2 ]]; then usage_err "rm needs a worktree name"; fi
    require_repo
    rm_picked "$(main_checkout)" "$force"
    return 0
  fi

  require_repo
  local repo
  repo=$(main_checkout)

  local matches count
  matches=$(find_worktree "$repo" "$needle" "$(sanitize_name "$needle")")
  count=$(printf '%s' "$matches" | grep -c . || true)

  if [[ $count -eq 0 ]]; then
    die "no worktree matching '$needle' - try: wtx ls"
  fi
  if [[ $count -gt 1 ]]; then
    info "'$needle' matches more than one worktree:"
    printf '%s\n' "$matches" | cut -f1 >&2
    die "name one of them exactly"
  fi

  remove_worktree "$repo" "$matches" "$force"
}

# Let the user choose worktrees to remove, one path per line on stdout. Shows
# the ls table without the main checkout. fzf when it is installed (fuzzy
# search, Tab to pick several), else a numbered menu.
pick_worktrees() {
  local repo=$1
  local base base_label wt_parent now
  base=$(default_base "$repo")
  base_label=${base##*/}
  if [[ -z $base_label ]]; then base_label=base; fi
  wt_parent=$(worktree_parent "$repo")
  wt_parent=${wt_parent%/}
  now=$(date +%s)

  info "checking worktrees..."
  local -a paths=()
  local path branch label dirty ab ct cr
  local rows="NAME"$'\t'"BRANCH"$'\t'"STATE"$'\t'"±$base_label"$'\t'"AGE"$'\n'
  while IFS=$'\t' read -r path branch label dirty ab ct cr; do
    if [[ $path == "$repo" ]]; then continue; fi
    paths+=("$path")
    rows+="$(worktree_name "$repo" "$wt_parent" "$path")"$'\t'"$label"
    rows+=$'\t'"$dirty"$'\t'"$ab"$'\t'"$(short_age "$ct" "$now")"$'\n'
  done < <(worktree_rows "$repo" "$base")
  if [[ ${#paths[@]} -eq 0 ]]; then
    die "no worktrees here besides the main checkout"
  fi

  # Room for what goes in front of each row: fzf's pointer, or "12) ".
  local n=${#paths[@]} digits=${#paths[@]} width
  width=$(terminal_width)
  local -a shown=()
  local line
  if command -v fzf >/dev/null; then
    while IFS= read -r line; do shown+=("${line#  }"); done < <(
      printf '%s' "$rows" | fit_table $((width - 2))
    )
    local i
    {
      printf '%s\t%s\n' - "${shown[0]}"
      for ((i = 0; i < n; i++)); do
        printf '%s\t%s\n' "${paths[i]}" "${shown[i + 1]}"
      done
    } | fzf --multi --delimiter=$'\t' --with-nth=2 --header-lines=1 \
      --height=40% --reverse --prompt='remove> ' \
      --header='Enter to remove, Tab to pick several, Esc to cancel' |
      cut -f1 || true
    return 0
  fi

  while IFS= read -r line; do shown+=("${line#  }"); done < <(
    printf '%s' "$rows" | fit_table $((width - digits))
  )
  local i
  printf '%*s%s\n' $((digits + 2)) '' "${shown[0]}" >&2
  for ((i = 1; i <= n; i++)); do
    printf '%*s) %s\n' "$digits" "$i" "${shown[i]}" >&2
  done

  local reply
  while true; do
    read -rp "remove which? (number, Enter to cancel) " reply || return 0
    if [[ -z $reply ]]; then return 0; fi
    if [[ $reply =~ ^[0-9]+$ ]] && ((reply >= 1 && reply <= n)); then
      printf '%s\n' "${paths[reply - 1]}"
      return 0
    fi
    info "not a number from the list"
  done
}

# Remove what the user picks. With several, one failing check does not stop
# the rest, but the exit status says something was left behind.
rm_picked() {
  local repo=$1 force=$2
  local -a picked=()
  local path
  while IFS= read -r path; do
    if [[ -n $path ]]; then picked+=("$path"); fi
  done < <(pick_worktrees "$repo")
  if [[ ${#picked[@]} -eq 0 ]]; then
    info "nothing picked, nothing removed"
    return 0
  fi

  local failed=0 line
  for path in "${picked[@]}"; do
    line=$(list_worktrees "$repo" | awk -F'\t' -v p="$path" '$1 == p')
    if [[ ${#picked[@]} -eq 1 ]]; then
      remove_worktree "$repo" "$line" "$force"
      return 0
    fi
    # a subshell, so a check that dies only skips this one
    (remove_worktree "$repo" "$line" "$force") || failed=$((failed + 1))
    info ''
  done
  if [[ $failed -gt 0 ]]; then
    die "$failed of ${#picked[@]} worktree(s) not removed"
  fi
}

# Remove one worktree, given its list_worktrees line. Dies on the first thing
# that makes removal unsafe, unless force is 1.
remove_worktree() {
  local repo=$1 force=$3
  local dest branch state head
  IFS=$'\t' read -r dest branch state head <<<"$2"
  if [[ $branch == '-' ]]; then
    info "found $dest $(branch_label "$branch" "$head")"
  else
    info "found $dest (branch $branch)"
  fi

  if [[ $force -eq 0 ]]; then
    # Slow on a big working tree, so say what we are waiting on.
    if [[ -d $dest ]]; then
      info "checking for uncommitted changes..."
      if [[ -n $(git -C "$dest" status --porcelain) ]]; then
        info "$dest has uncommitted changes:"
        git -C "$dest" status --short >&2
        die "commit or stash them, or pass --force"
      fi
    fi
    # Only that it is on *a* remote. Whether it is merged is git's business.
    if [[ $branch != '-' ]]; then
      if [[ -z $(git -C "$repo" remote) ]]; then
        # Every commit would count as unpushed, so the check says nothing here.
        # Say that out loud rather than silently dropping a safety net.
        info "this repo has no remote, so there is nothing to check against"
      else
        info "checking for unpushed commits..."
        local unpushed
        unpushed=$(git -C "$repo" rev-list --count "$branch" --not --remotes)
        if [[ $unpushed -gt 0 ]]; then
          info "$branch has $unpushed commit(s) that are on no remote:"
          git -C "$repo" log --oneline "$branch" --not --remotes >&2
          die "push them, or pass --force"
        fi
      fi
    fi
  fi

  if [[ -d $dest ]]; then
    # The slowest step by far: this deletes the directory, and node_modules in
    # a monorepo is gigabytes. Without a line here it looks like a hang.
    info "deleting the worktree directory (slow if node_modules is big)..."
    # --force is safe here: the checks above already ran, and this stops git's
    # own duplicate checks (untracked files, submodules) from blocking us.
    git -C "$repo" worktree remove --force "$dest" || die "could not remove $dest"
  fi
  info "pruning git's worktree bookkeeping"
  git -C "$repo" worktree prune
  info "removed worktree $dest"
  if [[ $branch != '-' ]]; then info "kept branch $branch"; fi
  if [[ $state == locked ]]; then warn "that worktree was locked"; fi
}

# --- dispatch --------------------------------------------------------------

main() {
  local cmd=${1-}
  if [[ $# -gt 0 ]]; then shift; fi

  case $cmd in
    new) cmd_new "$@" ;;
    rm | remove) cmd_rm "$@" ;;
    ls | list) cmd_ls "$@" ;;
    help | --help | -h) usage ;;
    --version) printf 'wtx %s\n' "$WTX_VERSION" ;;
    '')
      usage >&2
      exit 2
      ;;
    *) usage_err "unknown command: $cmd" ;;
  esac
}

main "$@"
